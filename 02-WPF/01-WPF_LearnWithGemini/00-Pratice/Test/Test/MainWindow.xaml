<Window x:Class="Test.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Test"
        Title="我的高效清单" Height="600" Width="380"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FA">
    <Window.Resources>
        <local:TaskStatusConverter x:Key="StatusConverter"/>
        <local:PriorityColorConverter x:Key="PriorityConverter"/>

        <DropShadowEffect x:Key="CardShadow" BlurRadius="15" ShadowDepth="1" Opacity="0.1" Color="Black"/>

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="15" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#10000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="我的任务" FontSize="28" FontWeight="ExtraBold" 
                   Foreground="#2D3748" Margin="0,0,0,20"/>

        <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="8" 
                Effect="{StaticResource CardShadow}" Margin="0,0,0,25">
            <DockPanel>
                <Button Command="{Binding AddTaskCommand}" Content="+" FontSize="24" 
                        Width="40" Height="40" Style="{StaticResource IconButton}" 
                        Foreground="#4A90E2" DockPanel.Dock="Right" FontWeight="Bold"/>
                <TextBox Text="{Binding NewTaskContent, UpdateSourceTrigger=PropertyChanged}" 
                         BorderThickness="0" FontSize="16" VerticalContentAlignment="Center" 
                         Padding="10,0" Background="Transparent" 
                         Tag="在此输入新任务...">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="Opacity" Value="0.6"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>
            </DockPanel>
        </Border>

        <ListBox Grid.Row="2" ItemsSource="{Binding TodoList}" 
                 Background="Transparent" BorderThickness="0"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.VerticalScrollBarVisibility="Hidden">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="White" CornerRadius="12" Margin="0,0,0,12" Padding="15" 
                            Effect="{StaticResource CardShadow}"
                            Opacity="{Binding IsDone, Converter={StaticResource StatusConverter}}">
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Width="5" CornerRadius="2.5" Margin="0,0,15,0"
                                    Background="{Binding Priority, Converter={StaticResource PriorityConverter}}"/>

                            <CheckBox IsChecked="{Binding IsDone}" VerticalAlignment="Center" Margin="0,0,12,0">
                                <CheckBox.LayoutTransform>
                                    <ScaleTransform ScaleX="1.4" ScaleY="1.4"/>
                                </CheckBox.LayoutTransform>
                            </CheckBox>

                            <Button Content="" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                    DockPanel.Dock="Right" Style="{StaticResource IconButton}" Foreground="#FF5C5C"
                                    Command="{Binding DataContext.DeleteTaskCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                    CommandParameter="{Binding}"/>

                            <TextBlock Text="{Binding Content}" FontSize="16" VerticalAlignment="Center" Foreground="#4A5568">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                <Setter Property="Foreground" Value="#A0AEC0"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Window>