<Window x:Class="Pratice1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Pratice1"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="4*"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Border Margin="2.5" Background="#7278DD"/>
        </Grid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="10*"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <Border Margin="2.5" Background="#000EFF"/>
            </Grid>
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="2.5*"/>
                </Grid.RowDefinitions>
                <UniformGrid Grid.Row="0" Rows="1" Columns="5">
                    <Button Background="#7577DB" Margin="2.5,0,2.5,0"/>
                    <Button Background="#4599CE" Margin="2.5,0,2.5,0"/>
                    <Button Background="#DE80D3" Margin="2.5,0,2.5,0"/>
                    <Button Background="#4FB9B2" Margin="2.5,0,2.5,0"/>
                    <Button Background="#DF7B7D" Margin="2.5,0,2.5,0"/>
                </UniformGrid>
                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="1" Background="#FF1900" Margin="2.5"/>
                    <Border Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="1" Background="#FFF000" Margin="2.5"/>
                    <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="1" Background="#000FFF" Margin="2.5"/>
                    <Border Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="1" Background="#006C00" Margin="2.5"/>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
